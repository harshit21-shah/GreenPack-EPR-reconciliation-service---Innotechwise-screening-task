# LLM provider for reconciliation narratives.
# Options: ollama, openai
LLM_PROVIDER=ollama

# Ollama text generation settings.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# RAG embedding settings.
# Use "ollama" for local embeddings or "keyword" for offline keyword fallback.
RAG_EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# When true, /ask uses the same LLM_PROVIDER (ollama or openai) to synthesize an answer from retrieved chunks.
# When false, answers are extractive (joined chunk text). False is useful for offline tests.
RAG_POLICY_LLM=true

# Optional OpenAI settings.
# Used only when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
